{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm2fpga.local/schemas/mapped_design_ir.v0.schema.json",
  "title": "LLM2FPGA mapped_design_ir.v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "design_id",
    "target",
    "sources",
    "interfaces",
    "clocks",
    "instances",
    "memories",
    "ops",
    "schedule",
    "dataflow",
    "physical",
    "codegen",
    "estimates",
    "checks"
  ],
  "properties": {
    "schema": {
      "const": "mapped_design_ir.v0"
    },
    "design_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["board", "part", "device_family", "toolchain"],
      "properties": {
        "board": { "type": "string" },
        "part": { "type": "string" },
        "device_family": { "type": "string" },
        "chipdb": { "type": "string" },
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["environment", "yosys", "nextpnr"],
          "properties": {
            "environment": { "type": "string" },
            "yosys": { "type": "string" },
            "nextpnr": { "type": "string" },
            "fasm": { "type": "string" },
            "prjxray": { "type": "string" }
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compute_graph", "resource_graph"],
      "properties": {
        "compute_graph": { "$ref": "#/$defs/source_ref" },
        "resource_graph": { "$ref": "#/$defs/source_ref" },
        "model": { "$ref": "#/$defs/source_ref" },
        "weights": { "$ref": "#/$defs/source_ref" },
        "baseline": { "$ref": "#/$defs/source_ref" }
      }
    },
    "interfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/interface" }
    },
    "clocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/clock" }
    },
    "instances": {
      "type": "array",
      "items": { "$ref": "#/$defs/instance" }
    },
    "memories": {
      "type": "array",
      "items": { "$ref": "#/$defs/memory" }
    },
    "ops": {
      "type": "array",
      "items": { "$ref": "#/$defs/op" }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "transactions"],
      "properties": {
        "model": {
          "enum": ["static_single_clock", "static_multi_clock", "dynamic_boundary_static_core"]
        },
        "transactions": {
          "type": "array",
          "items": { "$ref": "#/$defs/transaction" }
        }
      }
    },
    "dataflow": {
      "type": "array",
      "items": { "$ref": "#/$defs/transfer" }
    },
    "physical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regions", "constraints"],
      "properties": {
        "regions": {
          "type": "array",
          "items": { "$ref": "#/$defs/region" }
        },
        "constraints": {
          "type": "array",
          "items": { "$ref": "#/$defs/physical_constraint" }
        }
      }
    },
    "codegen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top_module", "style", "outputs"],
      "properties": {
        "top_module": { "type": "string" },
        "style": {
          "enum": ["direct_systemverilog_static", "circt_hw_seq_sv", "mixed"]
        },
        "outputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sources_f", "systemverilog", "xdc", "nextpnr_hooks"],
          "properties": {
            "sources_f": { "type": "string" },
            "systemverilog": {
              "type": "array",
              "items": { "type": "string" }
            },
            "xdc": {
              "type": "array",
              "items": { "type": "string" }
            },
            "nextpnr_hooks": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "pre_pack": { "type": "string" },
                "pre_place": { "type": "string" },
                "pre_route": { "type": "string" },
                "post_route": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "estimates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cycles", "resources", "timing"],
      "properties": {
        "cycles": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "resources": { "$ref": "#/$defs/resources" },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_mhz"],
          "properties": {
            "target_mhz": { "type": "number", "exclusiveMinimum": 0 },
            "critical_paths": {
              "type": "array",
              "items": { "type": "string" }
            },
            "risk": { "enum": ["low", "medium", "high", "unknown"] }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    },
    "rationale": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "uri"],
      "properties": {
        "kind": { "type": "string" },
        "uri": { "type": "string" },
        "sha256": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "role", "clock"],
      "properties": {
        "id": { "type": "string" },
        "kind": {
          "enum": ["host_fixed", "jtag", "pcie_bar", "stream", "memory_mapped", "debug"]
        },
        "role": { "type": "string" },
        "clock": { "type": "string" },
        "ports": {
          "type": "array",
          "items": { "$ref": "#/$defs/port" }
        },
        "notes": { "type": "string" }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "direction", "width"],
      "properties": {
        "name": { "type": "string" },
        "direction": { "enum": ["input", "output", "inout"] },
        "width": { "type": "integer", "minimum": 1 }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mhz", "reset"],
      "properties": {
        "id": { "type": "string" },
        "mhz": { "type": "number", "exclusiveMinimum": 0 },
        "reset": { "type": "string" },
        "xdc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create_clock_period_ns": { "type": "number", "exclusiveMinimum": 0 },
            "port": { "type": "string" }
          }
        }
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "clock", "count"],
      "properties": {
        "id": { "type": "string" },
        "kind": {
          "enum": ["dsp_mac_lane", "lut_alu", "bram_buffer", "control_fsm", "mux", "pipeline_register", "extern_ip"]
        },
        "clock": { "type": "string" },
        "count": { "type": "integer", "minimum": 1 },
        "params": {
          "type": "object",
          "additionalProperties": true
        },
        "region": { "type": "string" },
        "implements": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "width", "depth", "ports", "clock"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["bram", "distributed_ram", "register_file", "external_fixed"] },
        "width": { "type": "integer", "minimum": 1 },
        "depth": { "type": "integer", "minimum": 1 },
        "ports": { "type": "string" },
        "clock": { "type": "string" },
        "region": { "type": "string" },
        "initialization": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": { "type": "string" },
            "layout": { "type": "string" }
          }
        }
      }
    },
    "op": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_op", "op_class", "shape", "quant", "binding"],
      "properties": {
        "id": { "type": "string" },
        "source_op": { "type": "string" },
        "op_class": {
          "enum": ["linear_tile", "matmul_tile", "dot_tile", "requant", "activation", "normalization", "copy", "control"]
        },
        "shape": {
          "type": "object",
          "additionalProperties": true
        },
        "quant": {
          "type": "object",
          "additionalProperties": true
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["instance"],
          "properties": {
            "instance": { "type": "string" },
            "lanes": { "type": "integer", "minimum": 1 },
            "memory": { "type": "string" },
            "region": { "type": "string" }
          }
        }
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cycle", "op", "uses"],
      "properties": {
        "id": { "type": "string" },
        "cycle": { "type": "integer", "minimum": 0 },
        "duration": { "type": "integer", "minimum": 1 },
        "op": { "type": "string" },
        "uses": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reads": {
          "type": "array",
          "items": { "type": "string" }
        },
        "writes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "transfer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "tensor", "cycle"],
      "properties": {
        "id": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "tensor": { "type": "string" },
        "cycle": { "type": "integer", "minimum": 0 },
        "duration": { "type": "integer", "minimum": 1 },
        "mechanism": {
          "enum": ["wire", "registered_wire", "bram_read", "bram_write", "stream", "host_fixed"]
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["coarse_region", "clock_region", "site_region", "bel"] },
        "clock_region": { "type": "string" },
        "bbox": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x0": { "type": "integer" },
            "y0": { "type": "integer" },
            "x1": { "type": "integer" },
            "y1": { "type": "integer" }
          }
        },
        "resources": { "$ref": "#/$defs/resources" }
      }
    },
    "physical_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "strength", "applies_to"],
      "properties": {
        "id": { "type": "string" },
        "kind": {
          "enum": ["pin_xdc", "clock_xdc", "region_hint", "packed_cell_bel_lock", "route_hint", "dont_touch"]
        },
        "strength": { "enum": ["hard", "soft", "advisory"] },
        "applies_to": {
          "type": "array",
          "items": { "type": "string" }
        },
        "value": {
          "type": "object",
          "additionalProperties": true
        },
        "lowering": {
          "enum": ["xdc", "sv_attribute", "yosys_json_patch", "nextpnr_pre_pack", "nextpnr_pre_place", "nextpnr_pre_route", "none"]
        },
        "reason": { "type": "string" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lut": { "type": "integer", "minimum": 0 },
        "ff": { "type": "integer", "minimum": 0 },
        "dsp": { "type": "integer", "minimum": 0 },
        "bram18": { "type": "integer", "minimum": 0 },
        "uram": { "type": "integer", "minimum": 0 }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "command"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["schema", "sim", "yosys", "nextpnr", "hil"] },
        "command": { "type": "string" },
        "expected": { "type": "string" }
      }
    }
  }
}
